{
  "expo": {
    "name": "Aura Moda",
    "slug": "ecommerce-ropa-mobile",
    "version": "1.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.aura.ecommerce",
      "versionCode": 3,
      "permissions": [
        "INTERNET"
      ]
    },
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      "expo-image",
      "expo-status-bar",
      "expo-sqlite",
      "expo-notifications"
    ]
  }
}
